%% Monostatic Sensing Array Design: Two-Stage Algorithm (Robust Fixed)
% 1. Stage I: Lasserre Hierarchy (Softened Constraints)
% 2. Stage II: Flat Extension (Soft Matching) to prevent infeasibility
% 3. Visualization

clear; clc; close all;
cvx_clear; 

%% 1. SYSTEM PARAMETERS
fprintf('--- Setting up System Parameters ---\n');
N_ant = 8;              
D_lambda = 10;          
a_lambda = D_lambda/2;  
theta_deg = 30;         
R_lambda = 50;          

% Normalized Parameters [-1, 1]
u = cosd(theta_deg);
r = R_lambda;
a = a_lambda;
scale_fac = a; 

%% 2. STAGE I: Global Optimization (Lasserre)
fprintf('--- Stage I: Lasserre Hierarchy (d=2, Normalized) ---\n');

n_xi = 8; 
deg_relaxation = 2; 
deg_moments = 2 * deg_relaxation;
powers = generate_monomial_powers(n_xi, deg_moments);
n_y = size(powers, 1);
idx_const = 1; 
idx_tau = find_power_index(powers, [0 0 0 0 0 0 0 1]);

% Solver: SeDuMi is best for moments, SDPT3 is okay.
% cvx_solver sedumi 

try
    cvx_begin sdp
        variable y(n_y)
        
        % Build Moment Matrix
        [Md_idx, dim_Md] = build_moment_matrix_idx(powers, deg_relaxation);
        M_d = y(Md_idx);
        
        % Objective: Minimize tau + Regularization
        % Increased regularization slightly to enforce boundedness
        minimize( y(idx_tau) + 1e-3 * trace(M_d) )
        
        subject to
            % 1. Unit Mass
            y(idx_const) == 1;
            
            % 2. Moment Matrix PSD
            M_d == semidefinite(dim_Md);
            
            % 3. Bounds (Relaxed)
            y(idx_tau) >= 0;
            
            % 4. Expected Moments E[m] constraints
            % Extract symbolic expressions for E[m_k]
            expected_m = cvx(zeros(5,1));
            expected_m(1) = 1; 
            for k=1:4
                % map to variable index k (1-based in powers is column k)
                p_vec = zeros(1, n_xi); p_vec(k) = 1;
                [~, idx] = ismember(p_vec, powers, 'rows');
                expected_m(k+1) = y(idx);
            end
            
            % Hankel Constraints on Expected Moments
            H_m = hankel_matrix_var(expected_m, 2);
            H_m == semidefinite(3);
            
            % Localizing on [-1, 1]
            H_sub = hankel_matrix_var(expected_m(1:end-2), 1);
            H_shf = hankel_matrix_var(expected_m(3:end), 1);
            (H_sub - H_shf) == semidefinite(2);
            
            % 5. PMI Constraint (Fisher Information)
            [basis_local, dim_local] = get_basis_indices(powers, deg_relaxation - 1);
            epsilon = 1e-5; % Relaxed epsilon
            
            % -- Construct PMI Blocks --
            c2 = scale_fac^2; c3 = (2*u/r)*scale_fac^3; c4 = (u^2/r^2)*scale_fac^4;
            L_Juu_lin = c2*blk_var(y,powers,basis_local,2) + c3*blk_var(y,powers,basis_local,3) + c4*blk_var(y,powers,basis_local,4);
            
            q11 = scale_fac^2; q12 = 2*(u/r)*scale_fac^3; q22 = (u^2/r^2)*scale_fac^4;
            L_m1m1 = blk_prod(y,powers,basis_local,1,1);
            L_m1m2 = blk_prod(y,powers,basis_local,1,2);
            L_m2m2 = blk_prod(y,powers,basis_local,2,2);
            L_Juu_quad = q11*L_m1m1 + q12*L_m1m2 + q22*L_m2m2;
            L_Juu = L_Juu_lin + L_Juu_quad - epsilon*eye(dim_local);
            
            C_rr = (1-u^2)^2 / (4*r^4);
            L_Jrr = C_rr*scale_fac^4 * (blk_var(y,powers,basis_local,4) + L_m2m2) - epsilon*eye(dim_local);
            
            C_ur = (1-u^2) / (2*r^2);
            L_Jur = C_ur * (scale_fac^3*blk_var(y,powers,basis_local,3) + (u/r)*scale_fac^4*blk_var(y,powers,basis_local,4) + ...
                            scale_fac^3*L_m1m2 + (u/r)*scale_fac^4*L_m2m2);
            
            L_W11 = blk_var(y,powers,basis_local,5); L_W12 = blk_var(y,powers,basis_local,6); L_W22 = blk_var(y,powers,basis_local,7);
            L_I = blk_var(y,powers,basis_local,0);
            Z = cvx(zeros(dim_local, dim_local));
            
            % PMI LMI
            [L_Juu, L_Jur, L_I, Z; L_Jur, L_Jrr, Z, L_I; L_I, Z, L_W11, L_W12; Z, L_I, L_W12, L_W22] == semidefinite(4*dim_local);
            
            % Trace Constraint
            L_tau = blk_var(y,powers,basis_local,8);
            (L_tau - (L_W11 + L_W22)) == semidefinite(dim_local);
            
    cvx_end
    
    if contains(cvx_status, 'Solved') || contains(cvx_status, 'Inaccurate')
        fprintf('Stage I Converged. tau: %.4f\n', cvx_optval);
        tm_star = double(expected_m); % Explicit double conversion here
    else
        error('Solver returned status: %s', cvx_status);
    end

catch ME
    fprintf('\n!!! Stage I Warning: %s !!!\n', ME.message);
    fprintf('Switching to Fallback: Uniform Initialization\n');
    % Fallback: uniform distribution moments
    m_fall = zeros(5,1); m_fall(1)=1;
    t_uni = linspace(-1,1,N_ant)';
    for k=1:4, m_fall(k+1) = mean(t_uni.^k); end
    tm_star = m_fall;
end

fprintf('Target Normalized Moments: [%.4f, %.4f, %.4f, %.4f, %.4f]\n', tm_star);

%% 3. STAGE II: Atomic Extraction (Soft Matching)
fprintf('\n--- Stage II: Atomic Extraction (Robust) ---\n');

% We need to find a valid measure 'z' that is CLOSE to 'tm_star'.
% Using hard equality z(1:5) == tm_star often causes infeasibility due to numeric noise.
K_ext = N_ant; 
n_z = 2*K_ext + 1;

cvx_begin sdp quiet
    variable z(n_z)
    % Objective: Minimize distance to target moments + trace regularization (low rank)
    minimize( 100 * norm(z(1:5) - tm_star) + 1e-2 * z(1) ) 
    
    subject to
        % Base validity
        z(1) >= 0.99; % Mass approx 1
        
        % Hankel PSD (Valid Moment Sequence)
        H = hankel_matrix_var(z, K_ext);
        H == semidefinite(K_ext+1);
        
        % Localizing [-1, 1]
        H_sub = hankel_matrix_var(z(1:end-2), K_ext-1);
        H_shf = hankel_matrix_var(z(3:end), K_ext-1);
        (H_sub - H_shf) == semidefinite(K_ext);
cvx_end

% Robust Check before Conversion
if ~contains(cvx_status, 'Solved') && ~contains(cvx_status, 'Inaccurate')
    fprintf('Stage II Optimization Failed (Status: %s). Using fallback layout.\n', cvx_status);
    atoms_phys = linspace(-a, a, N_ant)';
    weights = ones(N_ant, 1)/N_ant;
else
    fprintf('Stage II Converged. Extracting atoms...\n');
    % Convert to double ONLY now
    H_val = double(hankel_matrix_var(z, K_ext));
    
    % Extraction (ESPRIT / Vandermonde)
    r_rank = N_ant; 
    try
        % Stabilize Hankel: Use SVD to enforce rank N
        [U, S, V] = svd(H_val);
        H_clean = U(:,1:r_rank) * S(1:r_rank,1:r_rank) * V(:,1:r_rank)';
        
        H0 = H_clean(1:end-1, 1:r_rank);
        H1 = H_clean(2:end,   1:r_rank);
        
        atoms_norm = eig(pinv(H0) * H1);
        atoms_norm = real(atoms_norm);
        atoms_norm = atoms_norm(abs(atoms_norm) <= 1.01); % Filter valid
        atoms_norm = sort(atoms_norm);
        
        % If fewer atoms found, pad with uniform
        if length(atoms_norm) < N_ant
            fprintf('Warning: Only %d atoms valid. Filling rest.\n', length(atoms_norm));
            atoms_norm = [atoms_norm; linspace(-0.9, 0.9, N_ant - length(atoms_norm))'];
            atoms_norm = sort(atoms_norm);
        end
        
        atoms_phys = atoms_norm * scale_fac;
        
        % Weights
        m_phys = zeros(5,1);
        for k=0:4, m_phys(k+1) = tm_star(k+1) * scale_fac^k; end
        
        V_mat = zeros(5, length(atoms_phys));
        for i=1:5, V_mat(i,:) = atoms_phys'.^(i-1); end
        weights = lsqnonneg(V_mat, m_phys);
        
    catch ME
        fprintf('Extraction Error: %s. Using uniform.\n', ME.message);
        atoms_phys = linspace(-a, a, N_ant)';
        weights = ones(N_ant, 1)/N_ant;
    end
end

%% 4. VISUALIZATION
figure('Name', 'Optimized Array');
stem(atoms_phys, weights, 'filled', 'LineWidth', 2, 'Color', 'b');
hold on;
% Plot Uniform for Comparison
stem(linspace(-a,a,N_ant), 0.5*ones(N_ant,1)/N_ant, 'r--', 'Marker', 'none');
legend('Optimized (Lasserre)', 'Uniform (Ref)');
title(sprintf('Array Layout (N=%d, \theta=%.1f\circ)', N_ant, theta_deg));
xlabel('Position (\lambda)'); ylabel('Excitation Weight');
grid on; xlim([-a-1, a+1]);
xline([-a, a], 'k:', 'Aperture');


%% --- AUX FUNCTIONS (Keep these unchanged) ---
function powers = generate_monomial_powers(n, d)
    if n==1, powers=(0:d)'; return; end
    sub = generate_monomial_powers(n-1, d);
    powers=[];
    for k=0:d
        idx = sum(sub,2) <= d-k;
        if any(idx)
            powers = [powers; [repmat(k, sum(idx),1), sub(idx,:)]];
        end
    end
end

function idx = find_power_index(powers, target)
    [~, idx] = ismember(target, powers, 'rows');
end

function [indices, dim] = build_moment_matrix_idx(powers, d)
    basis = find(sum(powers,2)<=d);
    dim = length(basis);
    basis_pow = powers(basis,:);
    indices = zeros(dim);
    for i=1:dim
        for j=1:dim
            [~, indices(i,j)] = ismember(basis_pow(i,:)+basis_pow(j,:), powers, 'rows');
        end
    end
end

function [basis, dim] = get_basis_indices(powers, d)
    basis = find(sum(powers,2)<=d);
    dim = length(basis);
end

function blk = blk_var(y, powers, basis, var_idx)
    dim = length(basis);
    p_shift = zeros(1, size(powers,2));
    if var_idx>0, p_shift(var_idx)=1; end
    blk = cvx(zeros(dim));
    for i=1:dim
        for j=1:dim
            p_tot = powers(basis(i),:) + powers(basis(j),:) + p_shift;
            [~, loc] = ismember(p_tot, powers, 'rows');
            blk(i,j) = y(loc);
        end
    end
end

function blk = blk_prod(y, powers, basis, v1, v2)
    dim = length(basis);
    p_shift = zeros(1, size(powers,2));
    p_shift(v1)=1; p_shift(v2)=1; 
    blk = cvx(zeros(dim));
    for i=1:dim
        for j=1:dim
            p_tot = powers(basis(i),:) + powers(basis(j),:) + p_shift;
            [~, loc] = ismember(p_tot, powers, 'rows');
            blk(i,j) = y(loc);
        end
    end
end

function H = hankel_matrix_var(z, K)
    H = cvx(zeros(K+1));
    for i=1:K+1
        for j=1:K+1
            H(i,j) = z(i+j-1);
        end
    end
end
