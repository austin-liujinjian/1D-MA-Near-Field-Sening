run_sanity_checks(x_array, Nant, a, lambda, u, r, cFIM, eps_det);

function run_sanity_checks(x_two_stage, Nant, a, lambda, u, r, cFIM, eps_det)
% ============================================================
% Sanity check: compare objective across multiple geometries
% Geometries:
%   (1) Two-stage extracted array (x_two_stage)
%   (2) Two-edge (+/-a, 50/50)
%   (3) All-left (-a)
%   (4) All-right (+a)
%   (5) Sparse ULA on [-a,a] with spacing >= dmin if possible
%   (6) 3-point (-a,0,+a) with center weight 0.5
%
% Outputs:
%   det(Jbar), tr(Jbar^{-1}) (weighted for Cartesian trace), tr(J^{-1})
% ============================================================

    fprintf('\n============================================================\n');
    fprintf(' Sanity Check: objective comparison (same u,r,a,lambda, Nant)\n');
    fprintf('============================================================\n');

    % Suggested min spacing for ULA/sparse ULA (engineering baseline)
    dmin = 0.5 * lambda;

    % ---- Build candidate arrays ----
    x_all_left   = (-a) * ones(Nant,1);
    x_all_right  = ( a) * ones(Nant,1);

    % Two-edge: split Nant as evenly as possible
    nL = floor(Nant/2);
    nR = Nant - nL;
    x_two_edge = [(-a)*ones(nL,1); (a)*ones(nR,1)];

    % Sparse ULA: try enforce spacing >= dmin, otherwise fallback to full ULA
    x_sparse_ula = build_sparse_ula_on_aperture(Nant, a, dmin);

    % 3-point with center weight 0.5 -> counts: [0.25, 0.5, 0.25]
    % Rounding to Nant (largest-remainder)
    t3 = [-a; 0; a];
    w3 = [0.25; 0.50; 0.25];
    x_3pt_center05 = build_array_from_atoms_lr(t3, w3, Nant);

    % ---- Evaluate all cases ----
    cases = {
        'Two-stage (extracted)', x_two_stage;
        'Two-edge (±a)',         x_two_edge;
        'All-left (-a)',         x_all_left;
        'All-right (+a)',        x_all_right;
        'Sparse ULA',            x_sparse_ula;
        '3-point (w0=0.5)',      x_3pt_center05
    };

    % Header
    fprintf('%-22s | %-12s | %-14s | %-14s\n', ...
        'Case', 'det(Jbar)', 'tr(Jbar^{-1})', 'tr(J^{-1})');
    fprintf('%s\n', repmat('-',1,70));

    for i = 1:size(cases,1)
        name = cases{i,1};
        x    = cases{i,2};

        m = empirical_moments_order4(x);
        [fbar, ftrue, detbar] = eval_obj_from_m_consistent(m, u, r, cFIM, eps_det);

        fprintf('%-22s | %-12.3e | %-14.6e | %-14.6e\n', ...
            name, detbar, fbar, ftrue);
    end

    fprintf('%s\n', repmat('-',1,70));
    fprintf('Note: smaller tr(J^{-1}) is better.\n');

end

function x = build_sparse_ula_on_aperture(Nant, a, dmin)
% Build a "sparse ULA" baseline:
%   - Try to place Nant points uniformly in [-a,a] with spacing >= dmin.
%   - If impossible, fallback to standard ULA with Nant points over [-a,a].

    if Nant <= 1
        x = 0;
        return;
    end

    % If we require spacing >= dmin, max count possible is floor(2a/dmin)+1
    maxN = floor((2*a)/dmin) + 1;

    if Nant <= maxN
        % Choose Nant points equally spaced with step >= dmin by spanning full aperture
        % A simple way: take maxN grid then subsample evenly to Nant points.
        x_full = linspace(-a, a, maxN).';
        idx = round(linspace(1, maxN, Nant));
        idx = unique(idx, 'stable');
        % If uniqueness reduced count, adjust by filling nearest neighbors
        while length(idx) < Nant
            cand = setdiff(1:maxN, idx);
            % add the middle-most remaining
            [~, j] = min(abs(cand - (maxN+1)/2));
            idx = sort([idx, cand(j)]); %#ok<AGROW>
        end
        x = x_full(idx);
    else
        % Cannot satisfy dmin with Nant -> fallback to standard ULA
        x = linspace(-a, a, Nant).';
    end

    x = sort(x(:));
end

function x_array = build_array_from_atoms_lr(t_atoms, w_atoms, Nant)
% Largest-remainder rounding from weights to counts, then expand.
    t_atoms = t_atoms(:);
    w_atoms = w_atoms(:);
    w_atoms = w_atoms / sum(w_atoms);

    raw = w_atoms * Nant;
    counts = floor(raw);
    rem = Nant - sum(counts);

    frac = raw - counts;
    [~, idx] = sort(frac, 'descend');
    for k = 1:rem
        counts(idx(k)) = counts(idx(k)) + 1;
    end

    x_array = [];
    for i = 1:length(t_atoms)
        if counts(i) > 0
            x_array = [x_array; t_atoms(i) * ones(counts(i),1)]; %#ok<AGROW>
        end
    end

    if length(x_array) ~= Nant
        error('Rounding error: expected Nant=%d but got %d.', Nant, length(x_array));
    end

    x_array = sort(x_array(:));
end

function m = empirical_moments_order4(x)
% m_k = (1/N) sum x_n^k, return [m1..m4] as column
    x = x(:);
    m = zeros(4,1);
    for k = 1:4
        m(k) = mean(x.^k);
    end
end

function [fbar, ftrue, detbar] = eval_obj_from_m_consistent(m, u, r, cFIM, eps_det)
% Evaluate objective consistent with Stage I:
%   fbar = tr(Jbar^{-1}) for the 2x2 FIM in (u,r) after Jacobian weighting:
%          fbar = ( r^2/(1-u^2) * Juu_bar + Jrr_bar ) / detbar
%   ftrue = fbar / cFIM

    [Juu_bar, Jrr_bar, Jur_bar] = Jbar_from_m(m, u, r);
    detbar = Juu_bar*Jrr_bar - Jur_bar^2;

    if ~(isfinite(detbar) && detbar > max(eps_det,0) && Juu_bar > 0 && Jrr_bar > 0)
        fbar  = inf;
        ftrue = inf;
        return;
    end

    fbar = ( (r^2/(1-u^2)) * Juu_bar + Jrr_bar ) / detbar;
    ftrue = fbar / cFIM;
end

function [Juu_bar, Jrr_bar, Jur_bar] = Jbar_from_m(m, u, r)
% Must match your Stage-I closed forms inside common factor cFIM
    m1=m(1); m2=m(2); m3=m(3); m4=m(4);

    Juu_bar = ( m2 + (2*u/r)*m3 + (u^2/r^2)*m4 + (m1 + (u/r)*m2)^2 );
    Jrr_bar = ( (1-u^2)^2/(4*r^4) ) * ( m4 + m2^2 );
    Jur_bar = ( (1-u^2)/(2*r^2) ) * ( m3 + (u/r)*m4 + m1*m2 + (u/r)*m2^2 );
end
