%% demo_two_stage_Lasserre_flat.m
% Two-stage algorithm implementation (Draft: draft-0126-monostatic (1).pdf)
% Stage I: Lasserre moment-SOS relaxation (Q_d), d=2 (Eq. 41-44)
% Stage II: A-TKMP flat extension + 1D atomic extraction (Eq. 47-52)
%
% Requires: YALMIP + SDP solver (MOSEK recommended)

clear; clc; close all;
yalmip('clear');

%% --------------------- User Inputs ---------------------
N      = 25;        % number of antennas for final discretization
D      = 0.50;      % aperture length
a      = D/2;       % half-aperture, K=[-a,a]
epsJ   = 1e-6;      % epsilon in Jbar(m) >= eps*I (Eq. 35/38)
dRelax = 2;         % Lasserre order d (start with d=2 as in Eq. 44 form)

% target (u,r) pairs (you can add more rows)
UR_list = [
    0.2,  2.5;
    0.8,  2.5
];

% Solver settings
solver_name = 'mosek';   % 'mosek' / 'sdpt3' / 'sedumi'
verbose     = 1;

rng(1); % reproducibility for Stage II random objective <R,z>

%% --------------------- Loop over (u,r) pairs ---------------------
for idxUR = 1:size(UR_list,1)
    u = UR_list(idxUR,1);
    r = UR_list(idxUR,2);

    fprintf('\n==============================\n');
    fprintf('Target (u,r) = (%.4f, %.4f)\n', u, r);

    %% ----- build tau_ub from a simple feasible design (Eq. 39 idea) -----
    x_ula = linspace(-a, a, N).';
    m_ula = moments_from_x(x_ula);   % m0..m4
    tauub = scaled_obj_from_m(m_ula, u, r); % tr(Jbar^{-1})
    tauub = 1.2 * tauub; % small safety margin (still "redundant upper bound")

    fprintf('tau_ub (from ULA) = %.6e\n', tauub);

    %% ---------------- Stage I (Q_d) ----------------
    [mstar, tau_star, info1] = stage1_lasserre_Qd(u, r, a, epsJ, tauub, dRelax, solver_name, verbose);

    fprintf('Stage I done. tau_star = %.6e\n', tau_star);
    fprintf('m* = [m0..m4] = [%.4e %.4e %.4e %.4e %.4e]\n', mstar);

    %% ---------------- Stage II (SDR_k) + extraction ----------------
    kmax = 5; % per note in draft: <=5 atoms (Tchakaloff) (see Stage II text)
    [zstar, k_used, flat_rank] = stage2_ATKMP_flat_extension(mstar, a, kmax, solver_name, verbose);

    fprintf('Stage II done. k_used=%d, extracted rank r=%d\n', k_used, flat_rank);

    [t_atoms, w_atoms] = extract_atoms_1d_from_z(zstar, mstar, a, flat_rank);

    fprintf('Atoms (ti, wi):\n');
    disp([t_atoms(:), w_atoms(:)]);

    %% --------- Discretize measure -> N antenna positions ----------
    x_design = discretize_atoms_to_N(t_atoms, w_atoms, N);

    %% --------- Evaluate and Plot ----------
    m_design  = moments_from_x(x_design);
    tau_design = scaled_obj_from_m(m_design, u, r);

    fprintf('Scaled objective (design) tr(Jbar^{-1}) = %.6e\n', tau_design);

    plot_design(idxUR, a, x_design, t_atoms, w_atoms, u, r, tau_star, tau_design);
end

%% ========================================================================
%% ============================ Local functions ===========================
%% ========================================================================

function m = moments_from_x(x)
% moments m0..m4, m_k = (1/N) sum x^k, with m0=1 (Eq. 20)
x = x(:);
m0 = 1;
m1 = mean(x);
m2 = mean(x.^2);
m3 = mean(x.^3);
m4 = mean(x.^4);
m = [m0,m1,m2,m3,m4];
end

function Jbar = Jbar_from_m(m,u,r)
% Normalized information matrix Jbar (divide Eq.17-19 by c)
% Eq.17-19 give Juu,Jrr,Jur as functions of moments m1..m4
m1=m(2); m2=m(3); m3=m(4); m4=m(5);

Juu = m2 + (2*u/r)*m3 + (u^2/r^2)*m4 + (m1 + (u/r)*m2)^2;
Jrr = ((1-u^2)^2/(4*r^4))*(m4 + m2^2);
Jur = ((1-u^2)/(2*r^2))*( m3 + (u/r)*m4 + m1*m2 + (u/r)*m2^2 );

Jbar = [Juu, Jur; Jur, Jrr];
end

function tau = scaled_obj_from_m(m,u,r)
% scaled objective: tr(Jbar^{-1}) (Eq. 25-26 style)
Jbar = Jbar_from_m(m,u,r);
tau  = trace(inv(Jbar));
end

function [mstar, tau_star, info] = stage1_lasserre_Qd(u,r,a,epsJ,tauub,d,solver_name,verbose)
% Stage I: solve (Q_d) in Eq.(44) with d=2 start.
% Decision variables are "moments of xi" (y_alpha), where xi = [m1,m2,m3,m4,w11,w22,w12,tau]
% This matches Eq.(40)-(44).

nvar = 8; % [m1 m2 m3 m4 w11 w22 w12 tau]

degMaxY = 2*d;         % y includes monomials degree<=2d
E_y   = exponent_list(nvar, degMaxY);
idxMap = make_exp_index_map(E_y);

B_d  = exponent_list(nvar, d);     % v_d basis
B_l  = exponent_list(nvar, d-1);   % v_{d-1} basis (since constraints use Md-1 in Eq.44)

Ny = size(E_y,1);
y  = sdpvar(Ny,1);

% y0 = 1 (Eq. 44)
idx0 = exp2idx(zeros(1,nvar), idxMap);
Constraints = [y(idx0) == 1];

% Moment matrix Md(y) >= 0 (Eq. 44)
Md = moment_matrix(y, B_d, idxMap);
Constraints = [Constraints, Md >= 0];

% Build matrix polynomials for constraints (Eq. 44):
% 1) M2(m) >=0 ; 2) M1(g m) >=0  (Eq.31-33)
G_M2 = polyM2(nvar);
G_M1 = polyM1(nvar, a);

% 3) Jbar(m) - eps I >=0 ; 4) [Jbar I; I W] >=0 (Eq.35-38)
G_Jeps   = polyJbar_minus_epsI(nvar, u, r, epsJ);
G_block  = polyBlock_Jbar_I_W(nvar, u, r);

% 5) W >= 0 (in Eq.38; not explicitly listed in Eq.44 but consistent with PPMI)
G_W = polyW(nvar);

% scalar polynomials: tau-tr(W) >=0 ; tauub - tau >=0 ; tau >=0 (Eq.38-39 idea)
s_tau_minus_trW = poly_tau_minus_trW(nvar);
s_tauub_minus_tau = poly_tauub_minus_tau(nvar, tauub);
s_tau = poly_tau(nvar);

% Localizing constraints (Eq.42-44): Md-1( G y ) >=0 for matrix polynomials,
% and Md-1( s y ) >=0 for scalar polynomials.
LM_M2    = matrix_localizing(G_M2, y, B_l, idxMap);
LM_M1    = matrix_localizing(G_M1, y, B_l, idxMap);
LM_Jeps  = matrix_localizing(G_Jeps, y, B_l, idxMap);
LM_block = matrix_localizing(G_block, y, B_l, idxMap);
LM_W     = matrix_localizing(G_W, y, B_l, idxMap);

L_tau_trW    = scalar_localizing(s_tau_minus_trW, y, B_l, idxMap);
L_tauub_tau  = scalar_localizing(s_tauub_minus_tau, y, B_l, idxMap);
L_tau_pos    = scalar_localizing(s_tau, y, B_l, idxMap);

Constraints = [Constraints, LM_M2 >= 0, LM_M1 >= 0, LM_Jeps >= 0, LM_block >= 0, LM_W >= 0];
Constraints = [Constraints, L_tau_trW >= 0, L_tauub_tau >= 0, L_tau_pos >= 0];

% Objective: Ly(tau) (Eq.44)
e_tau = zeros(1,nvar); e_tau(8)=1;
idx_tau = exp2idx(e_tau, idxMap);
Objective = y(idx_tau);

ops = sdpsettings('solver', solver_name, 'verbose', verbose);
sol = optimize(Constraints, Objective, ops);
assert(sol.problem == 0, sol.info);

yopt = value(y);

% Extract Stage-I output moments m* (Eq.46): m_i* = Ly*(m_i)
mstar = zeros(1,5);
mstar(1) = 1;
for i=1:4
    e = zeros(1,nvar); e(i)=1;
    mstar(i+1) = yopt(exp2idx(e, idxMap));
end

tau_star = value(Objective);

% (Optional) rank check: rank Md == rank M_{d-1} (Eq.45)
Md_num  = value(Md);
Md1_num = moment_matrix_numeric(yopt, B_l, idxMap); % M_{d-1}
info.rank_Md  = numeric_rank(Md_num, 1e-8);
info.rank_Md1 = numeric_rank(Md1_num, 1e-8);
info.yopt = yopt;
end

function [zstar, k_used, r] = stage2_ATKMP_flat_extension(mstar, a, kmax, solver_name, verbose)
% Stage II: solve (SDR)_k (Eq.48) and test flatness (Eq.47).
% z = [z0..z_{2k}] is 1D extended tms; constraints:
% Mk(z) >=0, M_{k-1}(g z) >=0 with g(t)=a^2 - t^2.

m0to4 = mstar; % [m0..m4]
k_used = -1; zstar = []; r = -1;

for k=2:kmax
    z = sdpvar(2*k+1,1);

    Constraints = [];
    % match first 5 moments: z0..z4 = m*
    Constraints = [Constraints, z(1:5) == m0to4(:)];

    Mk = moment_matrix_1d(z, k);
    Mloc = localizing_matrix_1d(z, k-1, a);

    Constraints = [Constraints, Mk >= 0, Mloc >= 0];

    % generic random linear objective <R,z> (Eq.48)
    R = randn(2*k+1,1);
    Objective = R.'*z;

    ops = sdpsettings('solver', solver_name, 'verbose', verbose);
    sol = optimize(Constraints, Objective, ops);
    if sol.problem ~= 0
        continue;
    end

    zopt = value(z);
    Mk_num  = value(Mk);
    Mk1_num = moment_matrix_1d_numeric(zopt, k-1);

    rk  = numeric_rank(Mk_num, 1e-8);
    rk1 = numeric_rank(Mk1_num, 1e-8);

    if rk == rk1
        % flatness holds (Eq.47)
        k_used = k;
        zstar  = zopt(:).';
        r      = rk;
        return;
    end
end

error('Stage II failed: no k in [2,%d] achieved flatness.', kmax);
end

function [t_atoms, w_atoms] = extract_atoms_1d_from_z(zstar, mstar, a, r)
% 1D atomic extraction following Eq.(49)-(52).
% We solve for recurrence coefficients c_j from moment relations:
% z_{i+r} = sum_{j=0}^{r-1} c_j z_{i+j}, i=0..r-1.
% Then p(t)=t^r - sum c_j t^j; roots -> support points.

% Build Hankel H and rhs b using zstar moments
% zstar is [z0..z_{2k}]
H = zeros(r,r);
b = zeros(r,1);
for i=0:r-1
    for j=0:r-1
        H(i+1,j+1) = zstar(i+j+1);
    end
    b(i+1) = zstar(i+r+1);
end

% Solve H*c=b (least squares for robustness)
c = H\b;

% Polynomial p(t)=t^r - sum_{j=0}^{r-1} c_j t^j
% MATLAB roots expects descending powers:
pcoef = [1, -flipud(c(:)).']; % [1, -c_{r-1}, ..., -c0]

roots_all = roots(pcoef);

% keep (nearly) real roots within [-a,a]
tol_im = 1e-7;
real_roots = roots_all(abs(imag(roots_all))<tol_im);
t_atoms = real(real_roots);
t_atoms = t_atoms(t_atoms >= -a-1e-8 & t_atoms <= a+1e-8);

% If numerical issues drop roots, fallback: take closest-to-real r roots
if numel(t_atoms) < r
    [~,ord] = sort(abs(imag(roots_all)), 'ascend');
    t_atoms = real(roots_all(ord(1:r)));
end

t_atoms = sort(t_atoms(:));

% Weight recovery via Vandermonde (Eq.52) using first r moments m0..m_{r-1}
m_needed = zeros(r,1);
for ell=0:r-1
    m_needed(ell+1) = mstar(ell+1);
end

V = zeros(r,r);
for ell=0:r-1
    V(ell+1,:) = (t_atoms.').^ell;
end
w_atoms = V \ m_needed;

% enforce nonnegativity and sum-to-1 (small corrections per Eq.52 note)
w_atoms = max(w_atoms, 0);
s = sum(w_atoms);
if s <= 0
    w_atoms = ones(r,1)/r;
else
    w_atoms = w_atoms / s;
end
end

function x = discretize_atoms_to_N(t_atoms, w_atoms, N)
% Convert weights to integer antenna counts and output N-length position vector.
r = numel(t_atoms);
raw = w_atoms(:)*N;
cnt = floor(raw);
rem = N - sum(cnt);
[~,ord] = sort(raw - cnt, 'descend');
for i=1:rem
    cnt(ord(i)) = cnt(ord(i)) + 1;
end

x = [];
for i=1:r
    x = [x; repmat(t_atoms(i), cnt(i), 1)];
end

% numerical safety
if numel(x) ~= N
    x = x(1:min(N,numel(x)));
    if numel(x) < N
        x = [x; repmat(t_atoms(1), N-numel(x), 1)];
    end
end

x = sort(x);
end

function plot_design(figId, a, x_design, t_atoms, w_atoms, u, r, tau_star, tau_design)
figure(100+figId); clf;

subplot(2,1,1);
stem(t_atoms, w_atoms, 'filled'); grid on;
xlim([-a a]);
xlabel('Atom location t_i');
ylabel('Weight w_i');
title(sprintf('Stage-II atoms (u=%.2f,r=%.2f)', u, r));

subplot(2,1,2);
scatter(x_design, zeros(size(x_design)), 25, 'filled'); grid on;
xlim([-a a]);
ylim([-0.5 0.5]);
xlabel('Antenna position x_n');
yticks([]);
title(sprintf('Discretized array (N=%d).  tau*:%.3e  tau(des):%.3e', ...
    numel(x_design), tau_star, tau_design));
end

%% ===================== Moment/SOS building blocks =====================

function E = exponent_list(nvar, degMax)
% all exponent vectors alpha in N^nvar with sum(alpha)<=degMax
E = [];
alpha = zeros(1,nvar);
recur(1, degMax);
    function recur(pos, remaining)
        if pos == nvar
            alpha(pos) = remaining;
            E = [E; alpha]; %#ok<AGROW>
            for k=0:remaining-1
                alpha(pos)=k;
                E=[E; alpha]; %#ok<AGROW>
            end
            return;
        end
        for v=0:remaining
            alpha(pos)=v;
            recur(pos+1, remaining-v);
        end
    end
% remove duplicates (safe) and sort by total degree then lex
E = unique(E,'rows');
[~,ord] = sortrows([sum(E,2), E]);
E = E(ord,:);
end

function mp = make_exp_index_map(E)
% map exponent row -> index in y
mp = containers.Map;
for i=1:size(E,1)
    key = expkey(E(i,:));
    mp(key) = i;
end
end

function idx = exp2idx(expRow, mp)
key = expkey(expRow);
idx = mp(key);
end

function k = expkey(e)
k = sprintf('%d,', e);
end

function Md = moment_matrix(y, B, idxMap)
% Md(y) = Ly( v_d v_d^T ), entry (i,j)=y_{alpha_i+alpha_j}
nb = size(B,1);
Md = sdpvar(nb, nb, 'symmetric');
for i=1:nb
    for j=i:nb
        expSum = B(i,:) + B(j,:);
        idx = exp2idx(expSum, idxMap);
        Md(i,j) = y(idx);
        Md(j,i) = Md(i,j);
    end
end
end

function Md_num = moment_matrix_numeric(yopt, B, idxMap)
nb = size(B,1);
Md_num = zeros(nb,nb);
for i=1:nb
    for j=i:nb
        expSum = B(i,:) + B(j,:);
        idx = exp2idx(expSum, idxMap);
        Md_num(i,j) = yopt(idx);
        Md_num(j,i) = Md_num(i,j);
    end
end
end

function L = scalar_localizing(poly, y, B, idxMap)
% Md-ks(s y): entry(i,j)=Ly( s * x^{ai+aj} ) = sum_k coef_k y_{exp_k+ai+aj}
nb = size(B,1);
L = sdpvar(nb, nb, 'symmetric');
coef = poly.coef; exps = poly.exp;
for i=1:nb
    for j=i:nb
        expr = 0;
        for t=1:numel(coef)
            expSum = exps(t,:) + B(i,:) + B(j,:);
            idx = exp2idx(expSum, idxMap);
            expr = expr + coef(t)*y(idx);
        end
        L(i,j) = expr;
        L(j,i) = L(i,j);
    end
end
end

function ML = matrix_localizing(G, y, B, idxMap)
% Md-kG(G y): block matrix with blocks scalar_localizing(G_ij)
p = size(G,1);
nb = size(B,1);
ML = sdpvar(p*nb, p*nb, 'symmetric');

for i=1:p
    for j=1:p
        Lij = scalar_localizing(G{i,j}, y, B, idxMap);
        rr = (i-1)*nb+1 : i*nb;
        cc = (j-1)*nb+1 : j*nb;
        ML(rr,cc) = Lij;
    end
end
end

function r = numeric_rank(A, tol)
s = svd((A+A')/2);
r = sum(s > tol);
end

%% ===================== Polynomials in xi =====================
% xi = [m1 m2 m3 m4 w11 w22 w12 tau]
% polynomial represented by struct: .coef (T×1), .exp (T×nvar)

function p = poly_const(nvar, c)
p.coef = c;
p.exp  = zeros(1,nvar);
end

function p = poly_var(nvar, vidx)
e = zeros(1,nvar); e(vidx)=1;
p.coef = 1;
p.exp  = e;
end

function p = poly_sum(p1,p2)
p.coef = [p1.coef(:); p2.coef(:)];
p.exp  = [p1.exp; p2.exp];
end

function p = poly_scale(p0, s)
p = p0; p.coef = s*p0.coef;
end

function G = polyM2(nvar)
% M2(m) (Eq.32) with m0=1
% [1 m1 m2; m1 m2 m3; m2 m3 m4]
p1 = poly_const(nvar, 1);
pm1 = poly_var(nvar, 1);
pm2 = poly_var(nvar, 2);
pm3 = poly_var(nvar, 3);
pm4 = poly_var(nvar, 4);

G = cell(3,3);
G{1,1}=p1;  G{1,2}=pm1; G{1,3}=pm2;
G{2,1}=pm1; G{2,2}=pm2; G{2,3}=pm3;
G{3,1}=pm2; G{3,2}=pm3; G{3,3}=pm4;
end

function G = polyM1(nvar, a)
% M1(g m) (Eq.31): [[a^2*m0-m2, a^2*m1-m3]; [sym, a^2*m2-m4]]
p_a2 = poly_const(nvar, a^2);
pm1  = poly_var(nvar, 1);
pm2  = poly_var(nvar, 2);
pm3  = poly_var(nvar, 3);
pm4  = poly_var(nvar, 4);

p11 = poly_sum(p_a2, poly_scale(pm2,-1));
p12 = poly_sum(poly_scale(pm1, a^2), poly_scale(pm3,-1));
p22 = poly_sum(poly_scale(pm2, a^2), poly_scale(pm4,-1));

G = cell(2,2);
G{1,1}=p11; G{1,2}=p12;
G{2,1}=p12; G{2,2}=p22;
end

function G = polyW(nvar)
% W = [[w11 w12]; [w12 w22]]  (Eq.40)
pw11 = poly_var(nvar, 5);
pw22 = poly_var(nvar, 6);
pw12 = poly_var(nvar, 7);

G = cell(2,2);
G{1,1}=pw11; G{1,2}=pw12;
G{2,1}=pw12; G{2,2}=pw22;
end

function G = polyJbar_minus_epsI(nvar,u,r,epsJ)
% Jbar(m) - eps I2 (Eq.35/38)
% Jbar entries are degree-2 polynomials in m1..m4.

[Juu, Jur, Jrr] = polyJbar_entries(nvar,u,r);

Juu_eps = poly_sum(Juu, poly_const(nvar, -epsJ));
Jrr_eps = poly_sum(Jrr, poly_const(nvar, -epsJ));

G = cell(2,2);
G{1,1}=Juu_eps; G{1,2}=Jur;
G{2,1}=Jur;     G{2,2}=Jrr_eps;
end

function G = polyBlock_Jbar_I_W(nvar,u,r)
% Block matrix [[Jbar, I2]; [I2, W]] (Eq.37/38)
[Juu, Jur, Jrr] = polyJbar_entries(nvar,u,r);
pw11 = poly_var(nvar,5);
pw22 = poly_var(nvar,6);
pw12 = poly_var(nvar,7);

G = cell(4,4);
% top-left Jbar
G{1,1}=Juu; G{1,2}=Jur;
G{2,1}=Jur; G{2,2}=Jrr;

% top-right I2
G{1,3}=poly_const(nvar,1); G{1,4}=poly_const(nvar,0);
G{2,3}=poly_const(nvar,0); G{2,4}=poly_const(nvar,1);

% bottom-left I2
G{3,1}=poly_const(nvar,1); G{3,2}=poly_const(nvar,0);
G{4,1}=poly_const(nvar,0); G{4,2}=poly_const(nvar,1);

% bottom-right W
G{3,3}=pw11; G{3,4}=pw12;
G{4,3}=pw12; G{4,4}=pw22;
end

function [Juu, Jur, Jrr] = polyJbar_entries(nvar,u,r)
% Build polynomials for normalized Jbar entries (Eq.17-19 divided by c).
% Variables: m1 (idx1), m2 (idx2), m3 (idx3), m4 (idx4)

% monomials
e1 = zeros(1,nvar); e1(1)=1; % m1
e2 = zeros(1,nvar); e2(2)=1; % m2
e3 = zeros(1,nvar); e3(3)=1; % m3
e4 = zeros(1,nvar); e4(4)=1; % m4

% helper to assemble polynomial from (coef, exp)
mkpoly = @(coef,exp) struct('coef',coef(:),'exp',exp);

% Juu = m2 + 2u/r m3 + u^2/r^2 m4 + (m1 + (u/r)m2)^2
%     = m2 + 2u/r m3 + u^2/r^2 m4 + m1^2 + 2(u/r)m1m2 + (u^2/r^2)m2^2
coef = [
    1;
    2*u/r;
    (u^2/r^2);
    1;
    2*(u/r);
    (u^2/r^2)
];
exp  = [
    e2;
    e3;
    e4;
    2*e1;
    e1+e2;
    2*e2
];
Juu = mkpoly(coef,exp);

% Jrr = A*(m4 + m2^2), A=(1-u^2)^2/(4 r^4)
A = (1-u^2)^2/(4*r^4);
coef = [A; A];
exp  = [e4; 2*e2];
Jrr = mkpoly(coef,exp);

% Jur = B*( m3 + (u/r)m4 + m1m2 + (u/r)m2^2 ), B=(1-u^2)/(2 r^2)
B = (1-u^2)/(2*r^2);
coef = [
    B;
    B*(u/r);
    B;
    B*(u/r)
];
exp = [
    e3;
    e4;
    e1+e2;
    2*e2
];
Jur = mkpoly(coef,exp);
end

function p = poly_tau_minus_trW(nvar)
% tau - (w11+w22) >= 0 (Eq.38 -> localizing in Eq.44)
e_tau = zeros(1,nvar); e_tau(8)=1;
e_w11 = zeros(1,nvar); e_w11(5)=1;
e_w22 = zeros(1,nvar); e_w22(6)=1;
p.coef = [1; -1; -1];
p.exp  = [e_tau; e_w11; e_w22];
end

function p = poly_tauub_minus_tau(nvar, tauub)
% tauub - tau >= 0 (Eq.39 -> localizing in Eq.44)
e_tau = zeros(1,nvar); e_tau(8)=1;
p.coef = [tauub; -1];
p.exp  = [zeros(1,nvar); e_tau];
end

function p = poly_tau(nvar)
% tau >= 0
e_tau = zeros(1,nvar); e_tau(8)=1;
p.coef = 1;
p.exp  = e_tau;
end

%% ===================== Stage II matrices (1D) =====================
function Mk = moment_matrix_1d(z,k)
% Mk(z) size (k+1)x(k+1), entry z_{i+j}, i,j=0..k
Mk = sdpvar(k+1,k+1,'symmetric');
for i=0:k
    for j=i:k
        Mk(i+1,j+1) = z(i+j+1);
        Mk(j+1,i+1) = Mk(i+1,j+1);
    end
end
end

function Mk = moment_matrix_1d_numeric(z,k)
Mk = zeros(k+1,k+1);
for i=0:k
    for j=i:k
        Mk(i+1,j+1) = z(i+j+1);
        Mk(j+1,i+1) = Mk(i+1,j+1);
    end
end
end

function Mloc = localizing_matrix_1d(z,k,a)
% M_k(g z) with g(t)=a^2 - t^2, order k:
% entry = a^2 z_{i+j} - z_{i+j+2}, i,j=0..k
Mloc = sdpvar(k+1,k+1,'symmetric');
for i=0:k
    for j=i:k
        Mloc(i+1,j+1) = a^2*z(i+j+1) - z(i+j+3);
        Mloc(j+1,i+1) = Mloc(i+1,j+1);
    end
end
end

