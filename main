function M = build_moment_from_lookup(y, look)
% Build moment matrix Md(y) from lookup indices.
% IMPORTANT: inside CVX, M must be cvx-typed, not double.
nb = size(look,1);
M = cvx( zeros(nb,nb) );   % <-- key fix
for i=1:nb
    for j=1:nb
        M(i,j) = y( look(i,j) );
    end
end
M = (M + M')/2;
end

function M = build_scalar_localizing_from_lookup(y, Llook)
% Build scalar localizing matrix M_{d-1}(s y).
nb = Llook.nb; T = Llook.T;
M = cvx( zeros(nb,nb) );   % <-- key fix
for i=1:nb
    for j=1:nb
        s = 0;
        for t=1:T
            s = s + Llook.coef(t)*y(Llook.idx(i,j,t));
        end
        M(i,j) = s;
    end
end
M = (M + M')/2;
end

function ML = build_matrix_localizing_from_lookup(y, MLlook)
% Build matrix localizing matrix M_{d-1}(G y) for a matrix polynomial G.
p  = MLlook.p;
nb = MLlook.nb;
ML = cvx( zeros(p*nb, p*nb) );   % <-- key fix
for i=1:p
    for j=1:p
        Lij = build_scalar_localizing_from_lookup(y, MLlook.blocks{i,j});
        rr  = (i-1)*nb+1 : i*nb;
        cc  = (j-1)*nb+1 : j*nb;
        ML(rr,cc) = Lij;
    end
end
ML = (ML + ML')/2;
end
