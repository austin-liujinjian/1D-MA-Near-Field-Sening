%% demo_two_stage_CVX_pipeline.m
% Full CVX (SDPT3) two-stage pipeline:
% Stage I : Lasserre moment-SOS relaxation Q_d (d=2) -> m*
% Stage II: A-TKMP flat extension SDR_k -> z* -> atom extraction -> discretize to N antennas
%
% No YALMIP, no MOSEK required.
% Requirement: CVX installed and cvx_setup done; SDPT3 available in CVX.
%
% Notes:
%   - CVX is a modeling layer; it still uses an SDP solver (here SDPT3).
%   - This script is written as one file with local functions.

clear; clc; close all;

%% =============== Basic parameters ===============
N    = 25;        % number of antennas after discretization
D    = 0.50;      % aperture length
a    = D/2;       % half aperture, support in [-a,a]
epsJ = 1e-6;      % epsilon in Jbar(m) >= eps*I

dRelax = 2;       % Lasserre order d (starter: d=2)
kmax   = 6;       % try k = 2..kmax in Stage II flat extension

% Target (u,r) list
UR_list = [
    0.2, 2.5;
    0.8, 2.5
];

% CVX settings
cvx_solver_name = 'sdpt3'; % use SDPT3
verbose = 1;               % 1: show CVX output; 0: quiet

rng(1);

%% =============== Loop over targets ===============
for idxUR = 1:size(UR_list,1)
    u = UR_list(idxUR,1);
    r = UR_list(idxUR,2);

    fprintf('\n==============================\n');
    fprintf('Target (u,r) = (%.4f, %.4f)\n', u, r);

    % tau upper bound from a feasible ULA (for redundant constraint tau <= tauub)
    x_ula = linspace(-a, a, N).';
    m_ula = moments_from_x(x_ula);           % [m0..m4]
    tauub = scaled_obj_from_m(m_ula, u, r);  % tr(Jbar^{-1})
    tauub = 1.2 * tauub;                    % safety margin
    fprintf('tau_ub (from ULA) = %.6e\n', tauub);

    %% ---------- Stage I (CVX) ----------
    [mstar, tau_star, info1] = stage1_lasserre_Qd_cvx(u, r, a, epsJ, tauub, dRelax, cvx_solver_name, verbose);
    fprintf('Stage I done. tau_star = %.6e, status=%s\n', tau_star, info1.cvx_status);
    fprintf('m* = [m0..m4] = [%.4e %.4e %.4e %.4e %.4e]\n', mstar);

    %% ---------- Stage II (CVX) ----------
    [zstar, k_used, flat_rank, info2] = stage2_ATKMP_flat_extension_cvx(mstar, a, kmax, cvx_solver_name, verbose);
    fprintf('Stage II done. k_used=%d, extracted rank r=%d, status=%s\n', k_used, flat_rank, info2.cvx_status);

    %% ---------- Extraction ----------
    [t_atoms, w_atoms] = extract_atoms_1d_from_z(zstar, mstar, a, flat_rank);
    fprintf('Atoms (ti, wi):\n');
    disp([t_atoms(:), w_atoms(:)]);

    %% ---------- Discretize to N antennas ----------
    x_design = discretize_atoms_to_N(t_atoms, w_atoms, N);

    %% ---------- Evaluate ----------
    m_design   = moments_from_x(x_design);
    tau_design = scaled_obj_from_m(m_design, u, r);
    fprintf('Scaled objective (design) tr(Jbar^{-1}) = %.6e\n', tau_design);

    %% ---------- Plot ----------
    plot_design(idxUR, a, x_design, t_atoms, w_atoms, u, r, tau_star, tau_design);
end

%% =====================================================================
%% ============================ Local functions =========================
%% =====================================================================

function m = moments_from_x(x)
x = x(:);
m0 = 1;
m1 = mean(x);
m2 = mean(x.^2);
m3 = mean(x.^3);
m4 = mean(x.^4);
m = [m0,m1,m2,m3,m4];
end

function Jbar = Jbar_from_m(m,u,r)
m1=m(2); m2=m(3); m3=m(4); m4=m(5);

Juu = m2 + (2*u/r)*m3 + (u^2/r^2)*m4 + (m1 + (u/r)*m2)^2;
Jrr = ((1-u^2)^2/(4*r^4))*(m4 + m2^2);
Jur = ((1-u^2)/(2*r^2))*( m3 + (u/r)*m4 + m1*m2 + (u/r)*m2^2 );

Jbar = [Juu, Jur; Jur, Jrr];
end

function tau = scaled_obj_from_m(m,u,r)
Jbar = Jbar_from_m(m,u,r);
tau  = trace(inv(Jbar));
end

%% ========================== Stage I: CVX Q_d ==========================
function [mstar, tau_star, info] = stage1_lasserre_Qd_cvx(u,r,a,epsJ,tauub,d,cvx_solver_name,verbose)
% Stage I: Lasserre Q_d (starter d=2)
% xi = [m1 m2 m3 m4 w11 w22 w12 tau] (nvar=8)
% y indexes monomials up to degree 2d.

assert(d==2, 'This implementation is provided for d=2 (starter).');

nvar = 8;
degMaxY = 2*d;

E_y   = exponent_list(nvar, degMaxY);
idxMap = make_exp_index_map(E_y);

B_d  = exponent_list(nvar, d);
B_l  = exponent_list(nvar, d-1);

Ny = size(E_y,1);

% Polynomials
G_M2    = polyM2(nvar);
G_M1    = polyM1(nvar, a);
G_Jeps  = polyJbar_minus_epsI(nvar, u, r, epsJ);
G_block = polyBlock_Jbar_I_W(nvar, u, r);
G_W     = polyW(nvar);

s_tau_trW      = poly_tau_minus_trW(nvar);
s_tauub_tau    = poly_tauub_minus_tau(nvar, tauub);
s_tau          = poly_tau(nvar);

% indices
idx0 = exp2idx(zeros(1,nvar), idxMap);
e_tau = zeros(1,nvar); e_tau(8)=1;
idx_tau = exp2idx(e_tau, idxMap);

% Precompute lookups
Md_lookup        = moment_lookup(B_d, idxMap);
LM2_lookup       = matrix_localizing_lookup(G_M2, B_l, idxMap);
LM1_lookup       = matrix_localizing_lookup(G_M1, B_l, idxMap);
LJeps_lookup     = matrix_localizing_lookup(G_Jeps, B_l, idxMap);
Lblock_lookup    = matrix_localizing_lookup(G_block, B_l, idxMap);
LW_lookup        = matrix_localizing_lookup(G_W, B_l, idxMap);

L_tau_trW_lookup   = scalar_localizing_lookup(s_tau_trW, B_l, idxMap);
L_tauub_tau_lookup = scalar_localizing_lookup(s_tauub_tau, B_l, idxMap);
L_tau_lookup       = scalar_localizing_lookup(s_tau, B_l, idxMap);

% CVX
cvx_begin sdp
    if verbose==0, cvx_quiet(true); end
    cvx_solver(cvx_solver_name);

    variable y(Ny,1)
    minimize( y(idx_tau) )

    subject to
        y(idx0) == 1;

        Md = build_moment_from_lookup(y, Md_lookup);
        Md == semidefinite(size(Md,1));

        LM2    = build_matrix_localizing_from_lookup(y, LM2_lookup);
        LM1    = build_matrix_localizing_from_lookup(y, LM1_lookup);
        LJeps  = build_matrix_localizing_from_lookup(y, LJeps_lookup);
        Lblock = build_matrix_localizing_from_lookup(y, Lblock_lookup);
        LW     = build_matrix_localizing_from_lookup(y, LW_lookup);

        LM2    == semidefinite(size(LM2,1));
        LM1    == semidefinite(size(LM1,1));
        LJeps  == semidefinite(size(LJeps,1));
        Lblock == semidefinite(size(Lblock,1));
        LW     == semidefinite(size(LW,1));

        L1 = build_scalar_localizing_from_lookup(y, L_tau_trW_lookup);
        L2 = build_scalar_localizing_from_lookup(y, L_tauub_tau_lookup);
        L3 = build_scalar_localizing_from_lookup(y, L_tau_lookup);

        L1 == semidefinite(size(L1,1));
        L2 == semidefinite(size(L2,1));
        L3 == semidefinite(size(L3,1));
cvx_end

info.cvx_status = cvx_status;
info.cvx_optval = cvx_optval;

if ~strcmpi(cvx_status,'Solved') && ~strcmpi(cvx_status,'Inaccurate/Solved')
    error('Stage I (CVX) failed: %s', cvx_status);
end

yopt = y;

mstar = zeros(1,5);
mstar(1)=1;
for i=1:4
    e = zeros(1,nvar); e(i)=1;
    mstar(i+1) = yopt(exp2idx(e, idxMap));
end
tau_star = yopt(idx_tau);

end

%% ======================= Stage II: CVX SDR_k ==========================
function [zstar, k_used, r, info] = stage2_ATKMP_flat_extension_cvx(mstar, a, kmax, cvx_solver_name, verbose)
% Solve SDR_k (k=2..kmax) until flatness rank(Mk)=rank(Mk-1) holds.
% z = [z0..z_{2k}], constraints:
%   z0..z4 = m0..m4
%   Mk(z) >=0
%   M_{k-1}(g z) >=0, g(t)=a^2 - t^2
% objective: random linear <R,z>

m0to4 = mstar(:);
k_used = -1; zstar = []; r = -1;

cvx_stat_last = 'NotStarted';

for k=2:kmax
    zlen = 2*k+1;
    R = randn(zlen,1);

    cvx_begin sdp
        if verbose==0, cvx_quiet(true); end
        cvx_solver(cvx_solver_name);

        variable z(zlen,1)
        minimize( R.'*z )

        subject to
            z(1:5) == m0to4;   % z0..z4 fixed

            Mk   = moment_matrix_1d_expr(z, k);
            Mloc = localizing_matrix_1d_expr(z, k-1, a);

            Mk   == semidefinite(k+1);
            Mloc == semidefinite(k);    % (k-1)+1 = k
    cvx_end

    cvx_stat_last = cvx_status;

    if ~strcmpi(cvx_status,'Solved') && ~strcmpi(cvx_status,'Inaccurate/Solved')
        continue;
    end

    zopt = z;

    % Check flatness: rank(Mk)=rank(Mk-1)
    Mk_num  = moment_matrix_1d_numeric(zopt, k);
    Mk1_num = moment_matrix_1d_numeric(zopt, k-1);

    rk  = numeric_rank(Mk_num, 1e-8);
    rk1 = numeric_rank(Mk1_num, 1e-8);

    if rk == rk1
        k_used = k;
        zstar  = zopt(:).';  % row
        r      = rk;
        info.cvx_status = cvx_status;
        info.k_used = k_used;
        info.rank = r;
        return;
    end
end

info.cvx_status = cvx_stat_last;
error('Stage II failed: no k in [2,%d] achieved flatness. Last CVX status: %s', kmax, cvx_stat_last);
end

function Mk = moment_matrix_1d_expr(z,k)
% Mk(z): (k+1)x(k+1), entry z_{i+j}, i,j=0..k
Mk = zeros(k+1,k+1);
for i=0:k
    for j=0:k
        Mk(i+1,j+1) = z(i+j+1);
    end
end
Mk = (Mk+Mk')/2;
end

function Mloc = localizing_matrix_1d_expr(z,k,a)
% Localizing for g(t)=a^2 - t^2:
% entry = a^2 z_{i+j} - z_{i+j+2}, i,j=0..k
Mloc = zeros(k+1,k+1);
for i=0:k
    for j=0:k
        Mloc(i+1,j+1) = a^2*z(i+j+1) - z(i+j+3);
    end
end
Mloc = (Mloc+Mloc')/2;
end

function Mk = moment_matrix_1d_numeric(z,k)
Mk = zeros(k+1,k+1);
for i=0:k
    for j=0:k
        Mk(i+1,j+1) = z(i+j+1);
    end
end
Mk = (Mk+Mk')/2;
end

%% ===================== Atom extraction & discretization =================
function [t_atoms, w_atoms] = extract_atoms_1d_from_z(zstar, mstar, a, r)
% 1D extraction via recurrence + roots + Vandermonde weights.
% Build Hankel H, b from z0..z_{2k}:
% z_{i+r} = sum_{j=0}^{r-1} c_j z_{i+j}, i=0..r-1.

H = zeros(r,r);
b = zeros(r,1);
for i=0:r-1
    for j=0:r-1
        H(i+1,j+1) = zstar(i+j+1);
    end
    b(i+1) = zstar(i+r+1);
end

c = H\b;

% p(t)=t^r - sum c_j t^j
pcoef = [1, -flipud(c(:)).'];   % descending powers
roots_all = roots(pcoef);

tol_im = 1e-7;
real_roots = roots_all(abs(imag(roots_all))<tol_im);
t_atoms = real(real_roots);
t_atoms = t_atoms(t_atoms >= -a-1e-8 & t_atoms <= a+1e-8);

if numel(t_atoms) < r
    [~,ord] = sort(abs(imag(roots_all)), 'ascend');
    t_atoms = real(roots_all(ord(1:r)));
end
t_atoms = sort(t_atoms(:));

% weights from first r moments m0..m_{r-1}
m_needed = mstar(1:r).';
V = zeros(r,r);
for ell=0:r-1
    V(ell+1,:) = (t_atoms.').^ell;
end
w_atoms = V \ m_needed;

% numerical cleanup: nonneg + normalize
w_atoms = max(w_atoms, 0);
s = sum(w_atoms);
if s <= 0
    w_atoms = ones(r,1)/r;
else
    w_atoms = w_atoms / s;
end
end

function x = discretize_atoms_to_N(t_atoms, w_atoms, N)
% Convert continuous atoms to N discrete antennas by integer rounding of weights.
r = numel(t_atoms);
raw = w_atoms(:)*N;
cnt = floor(raw);
rem = N - sum(cnt);
[~,ord] = sort(raw - cnt, 'descend');
for i=1:rem
    cnt(ord(i)) = cnt(ord(i)) + 1;
end
x = [];
for i=1:r
    x = [x; repmat(t_atoms(i), cnt(i), 1)];
end
% safety
x = x(1:min(N,numel(x)));
if numel(x) < N
    x = [x; repmat(t_atoms(1), N-numel(x), 1)];
end
x = sort(x);
end

function plot_design(figId, a, x_design, t_atoms, w_atoms, u, r, tau_star, tau_design)
figure(100+figId); clf;

subplot(2,1,1);
stem(t_atoms, w_atoms, 'filled'); grid on;
xlim([-a a]);
xlabel('Atom location t_i'); ylabel('Weight w_i');
title(sprintf('Stage-II atoms (u=%.2f, r=%.2f)', u, r));

subplot(2,1,2);
scatter(x_design, zeros(size(x_design)), 25, 'filled'); grid on;
xlim([-a a]); ylim([-0.5 0.5]);
yticks([]); xlabel('Antenna position x_n');
title(sprintf('Discretized array (N=%d).  tau*:%.3e  tau(des):%.3e', ...
    numel(x_design), tau_star, tau_design));
end

function r = numeric_rank(A, tol)
s = svd((A+A')/2);
r = sum(s > tol);
end

%% ===================== Moment/SOS indexing utilities ===================
function E = exponent_list(nvar, degMax)
E = [];
alpha = zeros(1,nvar);
recur(1, degMax);
    function recur(pos, remaining)
        if pos == nvar
            for v=0:remaining
                alpha(pos)=v;
                E=[E; alpha]; %#ok<AGROW>
            end
            return;
        end
        for v=0:remaining
            alpha(pos)=v;
            recur(pos+1, remaining-v);
        end
    end
E = unique(E,'rows');
[~,ord] = sortrows([sum(E,2), E]);
E = E(ord,:);
end

function mp = make_exp_index_map(E)
mp = containers.Map;
for i=1:size(E,1)
    mp(expkey(E(i,:))) = i;
end
end

function idx = exp2idx(expRow, mp)
idx = mp(expkey(expRow));
end

function k = expkey(e)
k = sprintf('%d,', e);
end

function look = moment_lookup(B, idxMap)
nb = size(B,1);
look = zeros(nb,nb);
for i=1:nb
    for j=1:nb
        expSum = B(i,:) + B(j,:);
        look(i,j) = exp2idx(expSum, idxMap);
    end
end
end

function M = build_moment_from_lookup(y, look)
nb = size(look,1);
M = zeros(nb,nb);
for i=1:nb
    for j=1:nb
        M(i,j) = y( look(i,j) );
    end
end
M = (M+M')/2;
end

function Llook = scalar_localizing_lookup(poly, B, idxMap)
nb = size(B,1);
coef = poly.coef; exps = poly.exp;
Llook.nb = nb;
Llook.T  = numel(coef);
Llook.coef = coef(:);
Llook.idx = zeros(nb,nb,Llook.T);
for i=1:nb
    for j=1:nb
        for t=1:Llook.T
            expSum = exps(t,:) + B(i,:) + B(j,:);
            Llook.idx(i,j,t) = exp2idx(expSum, idxMap);
        end
    end
end
end

function M = build_scalar_localizing_from_lookup(y, Llook)
nb=Llook.nb; T=Llook.T;
M = zeros(nb,nb);
for i=1:nb
    for j=1:nb
        s = 0;
        for t=1:T
            s = s + Llook.coef(t)*y(Llook.idx(i,j,t));
        end
        M(i,j)=s;
    end
end
M = (M+M')/2;
end

function MLlook = matrix_localizing_lookup(G, B, idxMap)
p = size(G,1);
nb = size(B,1);
MLlook.p = p; MLlook.nb=nb;
MLlook.blocks = cell(p,p);
for i=1:p
    for j=1:p
        MLlook.blocks{i,j} = scalar_localizing_lookup(G{i,j}, B, idxMap);
    end
end
end

function ML = build_matrix_localizing_from_lookup(y, MLlook)
p=MLlook.p; nb=MLlook.nb;
ML = zeros(p*nb, p*nb);
for i=1:p
    for j=1:p
        Lij = build_scalar_localizing_from_lookup(y, MLlook.blocks{i,j});
        rr=(i-1)*nb+1:i*nb;
        cc=(j-1)*nb+1:j*nb;
        ML(rr,cc)=Lij;
    end
end
ML = (ML+ML')/2;
end

%% ===================== Polynomial representations ======================
% polynomial p(xi)=sum_t coef(t) * prod_i xi_i^{exp(t,i)}
function p = poly_const(nvar, c)
p.coef = c;
p.exp  = zeros(1,nvar);
end

function p = poly_var(nvar, vidx)
e = zeros(1,nvar); e(vidx)=1;
p.coef = 1;
p.exp  = e;
end

function p = poly_sum(p1,p2)
p.coef = [p1.coef(:); p2.coef(:)];
p.exp  = [p1.exp; p2.exp];
end

function p = poly_scale(p0, s)
p = p0; p.coef = s*p0.coef;
end

function G = polyM2(nvar)
p1 = poly_const(nvar, 1);
pm1 = poly_var(nvar, 1);
pm2 = poly_var(nvar, 2);
pm3 = poly_var(nvar, 3);
pm4 = poly_var(nvar, 4);
G = cell(3,3);
G{1,1}=p1;  G{1,2}=pm1; G{1,3}=pm2;
G{2,1}=pm1; G{2,2}=pm2; G{2,3}=pm3;
G{3,1}=pm2; G{3,2}=pm3; G{3,3}=pm4;
end

function G = polyM1(nvar, a)
p_a2 = poly_const(nvar, a^2);
pm1  = poly_var(nvar, 1);
pm2  = poly_var(nvar, 2);
pm3  = poly_var(nvar, 3);
pm4  = poly_var(nvar, 4);

p11 = poly_sum(p_a2, poly_scale(pm2,-1));
p12 = poly_sum(poly_scale(pm1, a^2), poly_scale(pm3,-1));
p22 = poly_sum(poly_scale(pm2, a^2), poly_scale(pm4,-1));

G = cell(2,2);
G{1,1}=p11; G{1,2}=p12;
G{2,1}=p12; G{2,2}=p22;
end

function G = polyW(nvar)
pw11 = poly_var(nvar, 5);
pw22 = poly_var(nvar, 6);
pw12 = poly_var(nvar, 7);
G = cell(2,2);
G{1,1}=pw11; G{1,2}=pw12;
G{2,1}=pw12; G{2,2}=pw22;
end

function G = polyJbar_minus_epsI(nvar,u,r,epsJ)
[Juu, Jur, Jrr] = polyJbar_entries(nvar,u,r);
Juu_eps = poly_sum(Juu, poly_const(nvar, -epsJ));
Jrr_eps = poly_sum(Jrr, poly_const(nvar, -epsJ));
G = cell(2,2);
G{1,1}=Juu_eps; G{1,2}=Jur;
G{2,1}=Jur;     G{2,2}=Jrr_eps;
end

function G = polyBlock_Jbar_I_W(nvar,u,r)
[Juu, Jur, Jrr] = polyJbar_entries(nvar,u,r);
pw11 = poly_var(nvar,5);
pw22 = poly_var(nvar,6);
pw12 = poly_var(nvar,7);

G = cell(4,4);
% top-left Jbar
G{1,1}=Juu; G{1,2}=Jur;
G{2,1}=Jur; G{2,2}=Jrr;

% top-right I2
G{1,3}=poly_const(nvar,1); G{1,4}=poly_const(nvar,0);
G{2,3}=poly_const(nvar,0); G{2,4}=poly_const(nvar,1);

% bottom-left I2
G{3,1}=poly_const(nvar,1); G{3,2}=poly_const(nvar,0);
G{4,1}=poly_const(nvar,0); G{4,2}=poly_const(nvar,1);

% bottom-right W
G{3,3}=pw11; G{3,4}=pw12;
G{4,3}=pw12; G{4,4}=pw22;
end

function [Juu, Jur, Jrr] = polyJbar_entries(nvar,u,r)
e1=zeros(1,nvar); e1(1)=1;
e2=zeros(1,nvar); e2(2)=1;
e3=zeros(1,nvar); e3(3)=1;
e4=zeros(1,nvar); e4(4)=1;

mkpoly = @(coef,exp) struct('coef',coef(:),'exp',exp);

% Juu = m2 + 2u/r m3 + u^2/r^2 m4 + (m1 + (u/r)m2)^2
coef = [1; 2*u/r; (u^2/r^2); 1; 2*(u/r); (u^2/r^2)];
exp  = [e2; e3; e4; 2*e1; e1+e2; 2*e2];
Juu = mkpoly(coef,exp);

A = (1-u^2)^2/(4*r^4);
coef=[A;A]; exp=[e4;2*e2];
Jrr = mkpoly(coef,exp);

B=(1-u^2)/(2*r^2);
coef=[B; B*(u/r); B; B*(u/r)];
exp=[e3; e4; e1+e2; 2*e2];
Jur = mkpoly(coef,exp);
end

function p = poly_tau_minus_trW(nvar)
e_tau=zeros(1,nvar); e_tau(8)=1;
e_w11=zeros(1,nvar); e_w11(5)=1;
e_w22=zeros(1,nvar); e_w22(6)=1;
p.coef=[1;-1;-1];
p.exp=[e_tau; e_w11; e_w22];
end

function p = poly_tauub_minus_tau(nvar, tauub)
e_tau=zeros(1,nvar); e_tau(8)=1;
p.coef=[tauub; -1];
p.exp=[zeros(1,nvar); e_tau];
end

function p = poly_tau(nvar)
e_tau=zeros(1,nvar); e_tau(8)=1;
p.coef=1;
p.exp=e_tau;
end
