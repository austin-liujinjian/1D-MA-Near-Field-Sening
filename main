%% Monostatic Sensing Array Design via Lasserre Hierarchy & Atomic Extraction (Normalized)
% Based on draft-0126-monostatic.pdf
% Implements the Two-Stage Algorithm with Domain Normalization [-1, 1]
% to fix numerical instability / infeasibility issues.

clear; clc; close all;

%% 1. SYSTEM PARAMETERS
fprintf('--- Setting up System Parameters ---\n');
N_ant = 8;              % Number of antennas (N)
D_lambda = 10;          % Aperture length in wavelengths (D/lambda)
a_lambda = D_lambda/2;  % Half-aperture
theta_deg = 30;         % Target AoA (degrees)
R_lambda = 50;          % Target range in wavelengths (r/lambda)

% Normalized parameters
u = cosd(theta_deg);    
r = R_lambda;           
a = a_lambda;           
N = N_ant;

% Scaling factor used for normalization
scale_fac = a; 

%% 2. STAGE I: Lasserre Hierarchy Optimization (Normalized Domain)
fprintf('--- Stage I: Solving Lasserre Hierarchy SDP (d=2, Normalized) ---\n');

% Variables in Lasserre hierarchy are now the NORMALIZED moments:
% tilde_m1, tilde_m2, tilde_m3, tilde_m4 (all in [-1, 1])
% plus W11, W12, W22, tau.

n_xi = 8; 
deg_relaxation = 2; 
deg_moments = 2 * deg_relaxation;

% Generate monomial basis powers
powers = generate_monomial_powers(n_xi, deg_moments);
n_y = size(powers, 1);

idx_const = 1; 
idx_tau = find(powers(:,8)==1 & sum(powers(:,1:7),2)==0);

try
    cvx_begin sdp
        % Use SeDuMi if available, it is often more robust for moment problems
        % cvx_solver sedumi 
        
        variable y(n_y)
        
        % Objective
        minimize( y(idx_tau) )
        
        subject to
            % 1. Normalization
            y(idx_const) == 1;
            
            % 2. Moment Matrix Constraint M_d(y) >= 0
            [Md_idx, dim_Md] = build_moment_matrix_idx(powers, deg_relaxation);
            M_d = y(Md_idx);
            M_d == semidefinite(dim_Md);
            
            % 3. Validity of tilde_m on [-1, 1] (Normalized Interval)
            % Hankel M_2(tilde_m) >= 0
            % We need to access variables 1..4 (tilde_m1..tilde_m4)
            [basis_local, dim_local] = get_basis_indices(powers, deg_relaxation - 1);
            
            % Construct Hankel blocks for tilde_m
            var_map = [0, 1, 2, 3, 4]; 
            H_m = cell(3,3);
            for i = 1:3
                for j = 1:3
                    deg_m = var_map(i) + var_map(j); 
                    H_m{i,j} = build_localizing_block(y, powers, basis_local, deg_m);
                end
            end
            mat_Hm = cell2mat(H_m);
            mat_Hm == semidefinite(3 * dim_local);
            
            % Constraint: M_1( (1 - t^2) * tilde_m ) >= 0
            % In normalized domain [-1,1], g(t) = 1 - t^2.
            % Blocks become: 1*M_k - M_{k+2}
            blk1 = build_localizing_block(y, powers, basis_local, 0) - ...
                   build_localizing_block(y, powers, basis_local, 2);
            blk2 = build_localizing_block(y, powers, basis_local, 1) - ...
                   build_localizing_block(y, powers, basis_local, 3);
            blk3 = build_localizing_block(y, powers, basis_local, 2) - ...
                   build_localizing_block(y, powers, basis_local, 4);
               
            M_loc_g = [blk1, blk2; blk2', blk3];
            M_loc_g == semidefinite(2 * dim_local);

            % 4. PMI Constraint (FIM) with SCALING FACTORS
            % We must scale the coefficients because m_k = a^k * tilde_m_k
            epsilon = 1e-3; % Slightly relaxed tolerance
            
            % --- J_uu Construction ---
            % Formula: m2 + (2u/r)m3 + (u^2/r^2)m4 + (m1 + (u/r)m2)^2
            % Scaled: a^2*tm2 + (2u/r)a^3*tm3 + (u^2/r^2)a^4*tm4 + ...
            
            coef_lin_2 = scale_fac^2;
            coef_lin_3 = (2*u/r) * scale_fac^3;
            coef_lin_4 = (u^2/r^2) * scale_fac^4;
            
            L_Juu_lin = coef_lin_2 * build_localizing_block(y, powers, basis_local, 2) + ...
                        coef_lin_3 * build_localizing_block(y, powers, basis_local, 3) + ...
                        coef_lin_4 * build_localizing_block(y, powers, basis_local, 4);
            
            % Quadratic part: (m1 + (u/r)m2)^2 = m1^2 + 2(u/r)m1m2 + (u/r)^2 m2^2
            % Scaled: a^2*tm1^2 + 2(u/r)a^3*tm1tm2 + (u^2/r^2)a^4*tm2^2
            coef_quad_11 = scale_fac^2;
            coef_quad_12 = 2 * (u/r) * scale_fac^3;
            coef_quad_22 = (u^2/r^2) * scale_fac^4;
            
            L_m1m1 = build_localizing_block_prod(y, powers, basis_local, 1, 1);
            L_m1m2 = build_localizing_block_prod(y, powers, basis_local, 1, 2);
            L_m2m2 = build_localizing_block_prod(y, powers, basis_local, 2, 2);
            
            L_Juu_quad = coef_quad_11 * L_m1m1 + coef_quad_12 * L_m1m2 + coef_quad_22 * L_m2m2;
            
            L_Juu = L_Juu_lin + L_Juu_quad - epsilon * eye(dim_local);
            
            % --- J_rr Construction ---
            % Formula: C_rr * (m4 + m2^2)
            C_rr = (1-u^2)^2 / (4*r^4);
            % Scaled: a^4 * tm4 + a^4 * tm2^2
            scale_rr = scale_fac^4;
            
            L_Jrr = C_rr * scale_rr * (build_localizing_block(y, powers, basis_local, 4) + ...
                                       L_m2m2) - epsilon * eye(dim_local);
                        
            % --- J_ur Construction ---
            % Formula: C_ur * (m3 + (u/r)m4 + m1m2 + (u/r)m2^2)
            C_ur = (1-u^2) / (2*r^2);
            % Scaled terms: a^3*tm3, (u/r)a^4*tm4, a^3*tm1tm2, (u/r)a^4*tm2^2
            
            term_m3 = scale_fac^3 * build_localizing_block(y, powers, basis_local, 3);
            term_m4 = (u/r) * scale_fac^4 * build_localizing_block(y, powers, basis_local, 4);
            term_m1m2 = scale_fac^3 * L_m1m2;
            term_m2m2 = (u/r) * scale_fac^4 * L_m2m2;
            
            L_Jur = C_ur * (term_m3 + term_m4 + term_m1m2 + term_m2m2);
            
            % --- W Blocks ---
            L_W11 = build_localizing_block_var(y, powers, basis_local, 5);
            L_W12 = build_localizing_block_var(y, powers, basis_local, 6);
            L_W22 = build_localizing_block_var(y, powers, basis_local, 7);
            L_I   = build_localizing_block(y, powers, basis_local, 0); 
            
            Z_blk = zeros(dim_local);
            PMI_Mat = [L_Juu, L_Jur, L_I,   Z_blk;
                       L_Jur, L_Jrr, Z_blk, L_I;
                       L_I,   Z_blk, L_W11, L_W12;
                       Z_blk, L_I,   L_W12, L_W22];
                   
            PMI_Mat == semidefinite(4 * dim_local);
            
            % 5. Trace Constraint
            L_tau = build_localizing_block_var(y, powers, basis_local, 8);
            L_trW = L_W11 + L_W22;
            (L_tau - L_trW) == semidefinite(dim_local);
            
            % Redundant bound to help solver
            y(idx_tau) >= 0; 
            
    cvx_end
catch ME
    fprintf('Error in CVX definition: %s\n', ME.message);
    cvx_status = 'Failed';
end

if strcmp(cvx_status, 'Solved') || strcmp(cvx_status, 'Inaccurate/Solved')
    fprintf('Stage I Converged. Optimal tau: %.4f\n', cvx_optval);
    
    % Extract Normalized Moments tilde_m*
    tm_star = zeros(5,1);
    tm_star(1) = 1;
    for k = 1:4
        p_t = zeros(1, n_xi); p_t(k) = 1;
        [~, idx] = ismember(p_t, powers, 'rows');
        tm_star(k+1) = y(idx);
    end
    fprintf('Normalized Moments: [%.4f, %.4f, %.4f, %.4f, %.4f]\n', tm_star);
    
else
    fprintf('Stage I Failed: %s\n', cvx_status);
    return; % Stop execution
end

%% 3. STAGE II: Atomic Extraction (Normalized Domain)
fprintf('\n--- Stage II: Atomic Extraction (Normalized) ---\n');

% We perform extraction in the normalized domain [-1, 1] for stability
K_ext = N; 
deg_ext = 2 * K_ext;
n_z = deg_ext + 1;

cvx_begin sdp quiet
    variable z(n_z)
    minimize(0) 
    subject to
        z(1:5) == tm_star; % Match normalized moments
        
        H_z = hankel_matrix(z, K_ext);
        H_z == semidefinite(K_ext + 1);
        
        % Normalized Bounds [-1, 1]: M_{K-1}((1-t^2)z) >= 0
        H_z_sub = hankel_matrix(z(1:end-2), K_ext-1); 
        H_z_shift = hankel_matrix(z(3:end), K_ext-1); 
        
        (H_z_sub - H_z_shift) == semidefinite(K_ext);
cvx_end

% Extraction via Vandermonde
H = double(hankel_matrix(z, K_ext));
r_rank = N; 
H0 = H(1:end-1, 1:r_rank);
H1 = H(2:end,   1:r_rank);
atoms_norm = eig(pinv(H0) * H1);

% Filter and Scale Back
atoms_norm = real(atoms_norm);
atoms_norm = atoms_norm(abs(atoms_norm) <= 1 + 1e-3); % Check normalized bounds
atoms_norm = sort(atoms_norm);

% Scale back to physical domain [-a, a]
atoms_physical = atoms_norm * scale_fac;

% Recover Weights
% Using physical moments for weight recovery to be safe
% m_phys_k = sum(w_i * (x_i)^k)
m_phys_star = zeros(length(tm_star), 1);
for k=0:4
    m_phys_star(k+1) = (scale_fac^k) * tm_star(k+1);
end

V = zeros(length(m_phys_star), length(atoms_physical));
for i = 1:length(m_phys_star)
    V(i,:) = atoms_physical'.^(i-1);
end
weights = lsqnonneg(V, m_phys_star);

fprintf('\n--- Design Result ---\n');
fprintf('Recovered %d atoms:\n', length(atoms_physical));
disp(atoms_physical');
fprintf('Weights:\n');
disp(weights');

%% 4. VISUALIZATION
if ~isempty(atoms_physical)
    figure('Name', 'Antenna Layout');
    stem(atoms_physical, weights, 'filled', 'LineWidth', 2, 'MarkerSize', 8);
    xlabel('Position (Normalized \lambda)');
    ylabel('Weight / Power');
    title(sprintf('Optimized Array (N=%d)', length(atoms_physical)));
    grid on;
    xlim([-a-1, a+1]);
    xline([-a, a], 'r--', {'Aperture'}, 'LabelVerticalAlignment', 'bottom');
end

% ---------------------------------------------------------
% AUXILIARY FUNCTIONS (Same as before)
% ---------------------------------------------------------
function powers = generate_monomial_powers(n_vars, degree)
    if n_vars == 1
        powers = (0:degree)';
    else
        sub_powers = generate_monomial_powers(n_vars-1, degree);
        powers = [];
        for k = 0:degree
            valid_idx = sum(sub_powers, 2) <= (degree - k);
            if any(valid_idx)
                new_rows = [repmat(k, sum(valid_idx), 1), sub_powers(valid_idx, :)];
                powers = [powers; new_rows];
            end
        end
    end
    [~, idx] = sort(sum(powers, 2));
    powers = powers(idx, :);
end

function [indices, dim] = build_moment_matrix_idx(powers, d)
    deg_basis = sum(powers, 2);
    basis_idx = find(deg_basis <= d);
    dim = length(basis_idx);
    basis_powers = powers(basis_idx, :);
    indices = zeros(dim, dim);
    for i = 1:dim
        for j = 1:dim
            p_sum = basis_powers(i,:) + basis_powers(j,:);
            [~, loc] = ismember(p_sum, powers, 'rows');
            indices(i,j) = loc;
        end
    end
end

function [basis_idx, dim] = get_basis_indices(powers, d)
    basis_idx = find(sum(powers, 2) <= d);
    dim = length(basis_idx);
end

function blk = build_localizing_block(y, powers, basis_idx, m_deg)
    dim = length(basis_idx);
    basis_powers = powers(basis_idx, :);
    blk = cvx(zeros(dim, dim));
    p_shift = zeros(1, size(powers,2));
    if m_deg > 0
        p_shift(m_deg) = 1; 
    end
    for i = 1:dim
        for j = 1:dim
            p_total = basis_powers(i,:) + basis_powers(j,:) + p_shift;
            [found, loc] = ismember(p_total, powers, 'rows');
            if found
                blk(i,j) = y(loc);
            end
        end
    end
end

function blk = build_localizing_block_prod(y, powers, basis_idx, var1, var2)
    dim = length(basis_idx);
    basis_powers = powers(basis_idx, :);
    blk = cvx(zeros(dim, dim));
    p_shift = zeros(1, size(powers,2));
    p_shift(var1) = p_shift(var1) + 1;
    p_shift(var2) = p_shift(var2) + 1;
    for i = 1:dim
        for j = 1:dim
            p_total = basis_powers(i,:) + basis_powers(j,:) + p_shift;
            [found, loc] = ismember(p_total, powers, 'rows');
            if found
                blk(i,j) = y(loc);
            end
        end
    end
end

function blk = build_localizing_block_var(y, powers, basis_idx, var_idx)
    dim = length(basis_idx);
    basis_powers = powers(basis_idx, :);
    p_shift = zeros(1, size(powers,2));
    p_shift(var_idx) = 1;
    blk = cvx(zeros(dim, dim));
    for i = 1:dim
        for j = 1:dim
            p_total = basis_powers(i,:) + basis_powers(j,:) + p_shift;
            [~, loc] = ismember(p_total, powers, 'rows');
            blk(i,j) = y(loc);
        end
    end
end

function H = hankel_matrix(z, K)
    H = cvx(zeros(K+1, K+1));
    for i = 1:K+1
        for j = 1:K+1
            power = (i-1) + (j-1);
            H(i,j) = z(power + 1);
        end
    end
end
