ops = sdpsettings('solver', solver_name, ...
                  'verbose', verbose, ...
                  'debug', 1, ...
                  'savesolverinput', 1, ...
                  'savesolveroutput', 1);

sol = optimize(Constraints, Objective, ops);

if sol.problem ~= 0
    fprintf('\n[YALMIP] sol.problem = %d\n', sol.problem);
    disp('[YALMIP] yalmiperror:'); disp(yalmiperror(sol.problem));
    disp('[YALMIP] sol.info:');    disp(sol.info);
    disp('[YALMIP] sol.solver:');  disp(sol.solver);

    % 如果保存了 solver input/output，这里也能看（有时很大）
    % disp(sol.solverinput);
    % disp(sol.solveroutput);

    error('Stage I failed. See diagnostics above.');
end
